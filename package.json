{
  "name": "@aico/landing",
  "version": "0.1.0",
  "private": true,
  "description": "Mandy's public landing page: a static SvelteKit site, prerendered.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "NODE_ENV=production vite build && bun tools/compress.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@proglove/mai-kit": "git+ssh://git@github.com/Gitkubikon/mai-kit.git#4dea50a954dc0721e546f8e2d189731c60b74f99",
    "animejs": "^4.2.2",
    "livekit-client": "^2.22.3",
    "simple-icons": "^16.34.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26",
    "@types/three": "^0.186.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
