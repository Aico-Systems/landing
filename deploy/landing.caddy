# Mandy's landing page: a Caddy drop-in for the sandbox box's aico-caddy,
# which imports /etc/caddy/conf.d/*.caddy. `just deploy` syncs it and the
# built site (to landing/ beside it, the one host dir mounted into the
# container) and reloads Caddy.
mandy.insight-proglove.com {
	root * /etc/caddy/conf.d/landing
	try_files {path} {path}.html {path}/index.html

	# Hashed by the build: a new deploy is a new name, so keep them a year.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	# Same name every deploy (the scenes, the Draco decoder, share images):
	# an hour, then asked again (cheap: the ETag answers 304).
	@assets path /models/* /draco/* /og/* /favicon.svg
	header @assets Cache-Control "public, max-age=3600"
	# The pages: always asked again, so a deploy shows at once.
	@pages not path /_app/immutable/* /models/* /draco/* /og/* /favicon.svg
	header @pages Cache-Control "no-cache"

	# The build writes .br/.zst/.gz beside each file (tools/compress.ts), at
	# levels too slow for every request; anything without one is
	# compressed on the fly.
	encode zstd gzip
	file_server {
		precompressed br zstd gzip
	}
}
